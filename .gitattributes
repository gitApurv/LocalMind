# Normalise line endings in the repository and in every checkout, regardless of OS or
# core.autocrlf. Text files are stored and checked out with LF.
* text=auto eol=lf

# Windows-only scripts need CRLF to run under cmd.exe.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files: never touch line endings or diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.docx binary
*.jar binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
