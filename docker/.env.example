# Copy to docker/.env to override the defaults used by docker-compose.yml.
# The backend reads the same variable names (see backend/src/main/resources/application.yml),
# so set them in the backend's environment too when you change them.

# MySQL
MYSQL_IMAGE_TAG=8.4
MYSQL_ROOT_PASSWORD=admin
MYSQL_DATABASE=localmind
MYSQL_USER=localmind
MYSQL_PASSWORD=localmind
MYSQL_PORT=3306

# Qdrant
QDRANT_IMAGE_TAG=latest
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# SearXNG
SEARXNG_IMAGE_TAG=latest
SEARXNG_PORT=8081
SEARXNG_SECRET=localmind_searxng_secret_key
