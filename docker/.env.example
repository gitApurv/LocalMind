# Copy to docker/.env to override the defaults used by docker-compose.yml.
# Where the backend needs the same value it reads the same variable name (see
# backend/src/main/resources/application.yml), so set those in the backend's environment too:
# MYSQL_DATABASE, MYSQL_USER, MYSQL_PASSWORD, MYSQL_PORT, QDRANT_GRPC_PORT and SEARXNG_PORT
# (the backend's default SearXNG URL follows SEARXNG_PORT unless SEARXNG_BASE_URL is set).
# Compose-only (the backend never reads them): *_IMAGE_TAG, MYSQL_ROOT_PASSWORD, QDRANT_HTTP_PORT,
# SEARXNG_SECRET.

# MySQL
MYSQL_IMAGE_TAG=8.4
MYSQL_ROOT_PASSWORD=admin
MYSQL_DATABASE=localmind
MYSQL_USER=localmind
MYSQL_PASSWORD=localmind
MYSQL_PORT=3306

# Qdrant
QDRANT_IMAGE_TAG=v1.20.1
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# SearXNG
SEARXNG_IMAGE_TAG=2026.11.12-de722ab1b
SEARXNG_PORT=8081
SEARXNG_SECRET=localmind_searxng_secret_key
